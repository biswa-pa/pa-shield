# Copy to .env. Every value is optional.

# Address people open in the browser. Use your real https address in production
# (put your own TLS proxy in front of the gateway on PA_PORT).
PUBLIC_URL=http://localhost:8088
PA_PORT=8088
PA_STUN_PORT=3478

# Where the PA Shield images live. Leave as is to build them locally.
# Example: PA_IMAGE_PREFIX=ghcr.io/your-org/pa-shield
PA_IMAGE_PREFIX=pa-shield
PA_VERSION=1.0.0

# Official NetBird versions underneath.
NETBIRD_SERVER_TAG=0.74.4
NETBIRD_DASHBOARD_TAG=v2.90.3
