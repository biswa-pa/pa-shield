# Outgoing mail for password-reset emails (reset service, not the NetBird server).
# Copy to smtp.env (gitignored), fill SMTP_PASSWORD, then restart:
#   docker compose -f docker-compose.local.yml up -d reset
# Leave SMTP_HOST empty to skip email: the reset link is printed in the reset
# service log instead (docker compose -f docker-compose.local.yml logs reset).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
# starttls (587), ssl (465) or none
SMTP_SECURITY=starttls
SMTP_USER=common@predictaanalytics.io
SMTP_FROM=noreply@predictaanalytics.io
SMTP_PASSWORD=

# Address users open from the email. Local default shown.
PUBLIC_URL=http://localhost:8088
# Minutes a reset link stays valid.
RESET_TTL_MINUTES=30
