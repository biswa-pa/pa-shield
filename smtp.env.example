# Hostinger mailbox already used by Alertmanager.
# Copy to smtp.env (gitignored). The NetBird server does not read this file.
# scripts/check-smtp.sh uses it to prove the mailbox can send.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=common@predictaanalytics.io
SMTP_FROM=noreply@predictaanalytics.io
SMTP_PASSWORD=
